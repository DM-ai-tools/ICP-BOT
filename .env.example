# ---------------------------------------------------------------------------
# ICP Builder — environment
# Copy to .env for local development. NEVER commit .env.
# Every one of these is server-side only. Do not prefix any of them with
# NEXT_PUBLIC_ — the OpenAI key must never reach the browser.
# ---------------------------------------------------------------------------

# Required. Server-side only.
OPENAI_API_KEY=

# Required. Railway Postgres plugin provides this automatically in production.
# Local example: postgresql://postgres:postgres@localhost:5432/icp_builder?schema=public
DATABASE_URL=

# Generation model (gpt-4o class). Used for the three-pass document build,
# repair calls and the cross-scenario comparison.
OPENAI_MODEL=gpt-4o

# Fast model. Used for slot resolution (JSON mode) and the conversation turn.
OPENAI_MODEL_FAST=gpt-4o-mini

# --- Optional tuning (safe defaults applied if unset) ----------------------

# Per-request timeout for OpenAI calls, milliseconds.
# OPENAI_TIMEOUT_MS=120000

# Retries on 429 / 5xx (exponential backoff with jitter).
# OPENAI_MAX_RETRIES=4

# Max scenarios generated concurrently.
# GENERATION_CONCURRENCY=4

# Sampling temperature for document generation.
# OPENAI_TEMPERATURE=0.7

# Max output tokens per generation chunk.
# OPENAI_MAX_TOKENS=4000

# USD per 1M tokens, used only for cost logging. Update if your rates differ.
# OPENAI_PRICE_IN=2.5
# OPENAI_PRICE_OUT=10
# OPENAI_FAST_PRICE_IN=0.15
# OPENAI_FAST_PRICE_OUT=0.6

# Website scrape timeout, milliseconds.
# SCRAPE_TIMEOUT_MS=12000

# Railway sets PORT automatically. Do not hardcode it.
# PORT=3000

# Optional. When set, a page that a plain fetch cannot read — blocked at a
# firewall, or answered with a challenge shell — is retried through Firecrawl's
# browser. Only used as a fallback, so most sites never touch it.
FIRECRAWL_API_KEY=

# Signs the session cookie. Set a long random value in production — changing
# it signs everyone out. Falls back to a value derived from DATABASE_URL.
AUTH_SECRET=

# Seeded once on first boot, for the admin and the five user accounts. Changing
# these later does nothing; use the admin panel, which writes to the database.
ADMIN_PASSWORD=
USER_PASSWORD=
