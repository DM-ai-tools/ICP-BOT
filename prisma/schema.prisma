// ICP Builder — persistence.
// Postgres, NOT SQLite: Railway's filesystem is ephemeral and SQLite would
// lose every saved ICP on redeploy.

generator client {
  provider = "prisma-client-js"

  // Railway builds on Debian and runs on Debian, but the build layer and the
  // runtime layer are not guaranteed to be the same image — and when they are
  // not, a client generated for "native" only fails at boot with
  //   "Query engine binary for current platform ... could not be found"
  // which reads like a code fault and is not one. Naming the Linux targets
  // explicitly makes the deployed client correct regardless of which layer
  // generated it. "native" keeps local Windows and macOS development working.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One end-to-end session: the conversation, the resolved brief, and every
/// document generated from it. Conversation state lives here so a refresh or
/// a redeploy never loses a half-finished brief.
model Run {
  id    String @id @default(cuid())
  title String @default("Untitled ICP")

  /// Resolved slot values (see src/lib/slots.ts — SlotValues).
  slots Json @default("{}")

  /// Per-slot provenance: { source: stated|inferred|default, confidence,
  /// justification, editedByUser }.
  slotMeta Json @default("{}")

  /// Latest resolver diagnostics: missing[] and ambiguities[].
  missing     Json @default("[]")
  ambiguities Json @default("[]")

  /// Which slot the last question targeted, and how many times it has been put
  /// to the user. This is the hard loop-breaker: a slot asked twice without
  /// landing is assumed or skipped, never asked a third time. Without a counter,
  /// a slot the resolver cannot map produces the same question forever.
  lastAskedSlot  String?
  lastAskedCount Int     @default(0)

  /// Website fetch. Non-fatal: failure is mentioned once in chat, never blocks.
  siteContext     String?
  siteFetchStatus String? // pending | ok | failed | skipped
  siteFetchedUrl  String?
  siteNoticeShown Boolean @default(false)

  /// Sub-service discovery, run once off the same URL as the site fetch.
  /// idle | pending | ok | single | failed. 'single' means a real site that
  /// sells one thing — those strategists are never interrupted.
  discoveryStatus    String? @default("idle")
  discoveredServices Json    @default("[]") // DiscoveredService[]
  discoveryPagesRead Int     @default(0)

  /// What the strategist chose once discovery found several offers:
  /// generic | focused | both. scopeResolved gates the picker, so a strategist
  /// who dismisses it is not asked again on the next turn.
  scopeChoice   String?
  scopeResolved Boolean @default(false)

  /// Regulated vertical (health|dental|medical|finance|legal) — appends the
  /// compliance-language reminder and flags the run in the UI.
  regulated       Boolean @default(false)
  regulatedReason String?

  /// Stamped at creation and onto every document. The master prompt is
  /// immutable and versioned; documents record which version produced them.
  masterPromptVersion String

  /// The industry context pack this run was tailored with, if one resolved.
  industryPackId String?
  industryPack   IndustryPack? @relation(fields: [industryPackId], references: [id], onDelete: SetNull)

  /// Set once the awareness modal has been answered (or awareness was settled
  /// in conversation and the modal was skipped).
  awarenessResolvedInChat Boolean @default(false)
  awarenessModalAnswered  Boolean @default(false)

  /// Rolling usage totals for the run.
  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  costUsd          Float @default(0)

  messages    Message[]
  documents   Document[]
  comparisons Comparison[]
  usage       UsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model Message {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  role    String // user | assistant | system
  content String

  /// Ordinal within the thread; kept explicit so identical timestamps can't
  /// scramble the history sent to the resolver.
  seq Int

  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
}

/// One generated ICP document = one (service, awareness scenario) pair.
/// The unique constraint is what makes generation idempotent: a retry can
/// never duplicate a document or double-charge for one.
model Document {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  serviceIndex Int
  serviceName  String

  /// generic — the whole-business profile; focused — one sub-service.
  /// Denormalised from the slot it was generated for so the export can build
  /// its folder tree without rehydrating every snapshot.
  tier        String  @default("generic")
  /// Stable key for a focused document's sub-service. Positional indexes drift
  /// when a catalogue is re-ordered; a slug lands in the same folder every time.
  serviceSlug String?

  /// Internal scenario key, e.g. "problem_aware".
  scenario       String
  /// The master prompt's exact wording, e.g. "Only Problem-Aware".
  awarenessLabel String

  markdown String @default("")

  /// pending | generating | complete | repaired | failed | stale
  status String @default("pending")

  /// Per-section validation report (see src/lib/validate.ts).
  validation Json?

  /// Badge shown in the UI: complete | repaired | failed.
  badge String?

  errorMessage String?

  masterPromptVersion String

  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  costUsd          Float @default(0)

  /// Snapshot of the slots used, so an edited brief never rewrites history.
  slotsSnapshot Json?

  /// Which industry pack shaped this document. Kept per document because a
  /// rebuild after an industry edit must not silently claim the old tailoring.
  industryPackId String?
  industryPack   IndustryPack? @relation(fields: [industryPackId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@unique([runId, serviceIndex, scenario])
  @@index([runId])
}

/// Cross-scenario comparison table. One per (run, service) once 2+ scenarios
/// exist. Rendered as the first tab and the cover section of the combined
/// export — this is what makes the bundle a deliverable rather than loose files.
model Comparison {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  serviceIndex Int
  serviceName  String

  /// [{ scenario, dominantBelief, messageThatLands, messageThatBackfires,
  ///    bestChannel, primaryObjection }]
  rows Json @default("[]")

  markdown String @default("")

  /// Scenario keys the table was built from; a stale set triggers a rebuild.
  scenarioKeys Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, serviceIndex])
  @@index([runId])
}

/// A reusable block of domain context for one industry, in one region, for one
/// business model and audience type.
///
/// Cached because the same pack serves every future run in that combination —
/// a second Melbourne dental B2B run costs nothing. Curated packs are written
/// by hand for the verticals we actually sell into; anything else is generated
/// once and stored beside them.
model IndustryPack {
  id String @id @default(cuid())

  /// Cache key: canonicalIndustry|region|businessModel|audienceType
  key String @unique

  /// Canonical label, e.g. "dental". What the user typed is kept separately so
  /// the panel can show both.
  canonicalIndustry String
  industryRaw       String
  /// Other phrasings that resolve to this pack — "dentists", "dental clinics".
  aliases           Json   @default("[]")

  region        String
  businessModel String
  audienceType  String

  /// curated | generated
  source    String
  curatedId String?

  /// The pack itself (see src/lib/industry-types.ts).
  content Json

  /// How many runs have used it. Drives the admin hit-rate figure.
  useCount Int @default(0)

  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  costUsd          Float @default(0)

  runs      Run[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonicalIndustry])
}

/// Instance-wide settings, set from the admin panel.
///
/// A key/value table rather than columns on a singleton row: settings are read
/// on nearly every request and added occasionally, and this way adding one is a
/// code change with no migration.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Per-call token and cost logging.
model UsageLog {
  id    String  @id @default(cuid())
  runId String?
  run   Run?    @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// resolve | converse | generate_a | generate_b | generate_c | repair |
  /// compare | title
  kind  String
  model String

  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  costUsd          Float @default(0)

  durationMs Int?
  attempts   Int     @default(1)
  ok         Boolean @default(true)
  detail     String?

  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}
